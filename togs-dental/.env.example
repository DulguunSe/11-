# ===== Төгс шүдний эмнэлгийн систем — серверийн тохиргоо =====
# Энэ файлыг .env нэрээр хуулж утгуудыг бөглөнө. .env-ийг git-д ХЭЗЭЭ Ч бүү оруул.

# Сайтын домэйн (docker-compose ашиглах үед). Жишээ: togsdental.mn
DOMAIN=togsdental.mn

# Сайтын бүтэн хаяг (docker-compose-гүй ажиллуулбал). Instagram-д нийтлэхэд HTTPS заавал.
# PUBLIC_URL=https://togsdental.mn

# Нууц тохиргоог (Facebook токен, SMS түлхүүр) шифрлэх урт санамсаргүй үг. Нэг удаа тохируулаад бүү соль.
# Жишээ үүсгэх: openssl rand -base64 48
APP_SECRET=

# Анх ажиллахад үүсэх "admin" хэрэглэгчийн нууц үг (анх нэвтрээд солино)
INITIAL_ADMIN_PASSWORD=

# AI маркетинг: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# AI загвар (анхдагч claude-opus-5-5). Хямд хувилбар: claude-sonnet-5-5, claude-haiku-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Танилцуулгын жишээ өгөгдөл (эмч, үйлчлүүлэгч) нэмэх бол 1. Бодит ашиглалтад бүү асаа.
# SEED_DEMO=1

# Порт (анхдагч 3000)
# PORT=3000
