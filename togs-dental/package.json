{
  "name": "togs-dental",
  "private": true,
  "version": "1.0.0",
  "description": "Төгс шүдний эмнэлэг — вэбсайт, эмнэлгийн удирдлагын систем, AI маркетинг",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/build-server.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.ts",
    "backup": "node --disable-warning=ExperimentalWarning dist/server/backup.js",
    "create-admin": "node --disable-warning=ExperimentalWarning dist/server/create-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@hono/node-server": "^2.1.11",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.22",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
